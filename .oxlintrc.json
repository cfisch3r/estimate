{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "jsx-a11y"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/anchor-ambiguous-text": "error",
    "jsx-a11y/anchor-has-content": "error",
    "jsx-a11y/anchor-is-valid": "error",
    "jsx-a11y/aria-activedescendant-has-tabindex": "error",
    "jsx-a11y/aria-props": "error",
    "jsx-a11y/aria-proptypes": "error",
    "jsx-a11y/aria-role": "error",
    "jsx-a11y/aria-unsupported-elements": "error",
    "jsx-a11y/autocomplete-valid": "error",
    "jsx-a11y/click-events-have-key-events": "error",
    "jsx-a11y/control-has-associated-label": "error",
    "jsx-a11y/heading-has-content": "error",
    "jsx-a11y/html-has-lang": "error",
    "jsx-a11y/iframe-has-title": "error",
    "jsx-a11y/img-redundant-alt": "error",
    "jsx-a11y/interactive-supports-focus": "error",
    "jsx-a11y/label-has-associated-control": "error",
    "jsx-a11y/lang": "error",
    "jsx-a11y/media-has-caption": "error",
    "jsx-a11y/mouse-events-have-key-events": "error",
    "jsx-a11y/no-access-key": "error",
    "jsx-a11y/no-aria-hidden-on-focusable": "error",
    "jsx-a11y/no-autofocus": "error",
    "jsx-a11y/no-distracting-elements": "error",
    "jsx-a11y/no-interactive-element-to-noninteractive-role": "error",
    "jsx-a11y/no-noninteractive-element-interactions": "error",
    "jsx-a11y/no-noninteractive-element-to-interactive-role": "error",
    "jsx-a11y/no-noninteractive-tabindex": "error",
    "jsx-a11y/no-redundant-roles": "error",
    "jsx-a11y/no-static-element-interactions": "error",
    "jsx-a11y/prefer-tag-over-role": "error",
    "jsx-a11y/role-has-required-aria-props": "error",
    "jsx-a11y/role-supports-aria-props": "error",
    "jsx-a11y/scope": "error",
    "jsx-a11y/tabindex-no-positive": "error"
  },
  "overrides": [
    {
      "files": ["src/domain/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**", "!./**", "./../**"],
                "message": "The domain imports nothing outside src/domain (ADR-009)."
              }
            ]
          }
        ],
        "no-restricted-globals": [
          "error",
          {
            "name": "window",
            "message": "The domain does no I/O (ADR-009)."
          },
          {
            "name": "document",
            "message": "The domain does no I/O (ADR-009)."
          },
          {
            "name": "localStorage",
            "message": "The domain does no I/O (ADR-009)."
          },
          {
            "name": "sessionStorage",
            "message": "The domain does no I/O (ADR-009)."
          },
          {
            "name": "fetch",
            "message": "The domain does no I/O (ADR-009)."
          },
          {
            "name": "navigator",
            "message": "The domain does no I/O (ADR-009)."
          },
          {
            "name": "crypto",
            "message": "The domain does no I/O (ADR-009)."
          },
          {
            "name": "setTimeout",
            "message": "The domain does no I/O (ADR-009)."
          },
          {
            "name": "setInterval",
            "message": "The domain does no I/O (ADR-009)."
          }
        ]
      }
    },
    {
      "files": ["src/domain/*/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**", "!./**", "!../*", "./../**", "../../**"],
                "message": "The domain imports nothing outside src/domain (ADR-009)."
              }
            ]
          }
        ],
        "no-restricted-globals": [
          "error",
          {
            "name": "window",
            "message": "The domain does no I/O (ADR-009)."
          },
          {
            "name": "document",
            "message": "The domain does no I/O (ADR-009)."
          },
          {
            "name": "localStorage",
            "message": "The domain does no I/O (ADR-009)."
          },
          {
            "name": "sessionStorage",
            "message": "The domain does no I/O (ADR-009)."
          },
          {
            "name": "fetch",
            "message": "The domain does no I/O (ADR-009)."
          },
          {
            "name": "navigator",
            "message": "The domain does no I/O (ADR-009)."
          },
          {
            "name": "crypto",
            "message": "The domain does no I/O (ADR-009)."
          },
          {
            "name": "setTimeout",
            "message": "The domain does no I/O (ADR-009)."
          },
          {
            "name": "setInterval",
            "message": "The domain does no I/O (ADR-009)."
          }
        ]
      }
    },
    {
      "files": [
        "src/domain/**/*.test.ts",
        "src/domain/testFixtures.ts",
        "src/domain/estimate/testHelpers.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**", "!./**", "!../*", "!vitest", "./../**", "../../**"],
                "message": "The domain imports nothing outside src/domain (ADR-009)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/adapters/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/features/**",
                  "**/pages/**",
                  "**/widgets/**",
                  "**/app/**",
                  "**/entities/**",
                  "**/shared/**",
                  "react",
                  "react-dom",
                  "react/**",
                  "zustand",
                  "react-dom/**",
                  "zustand/**",
                  "react-router",
                  "react-router/**",
                  "**/features",
                  "**/pages",
                  "**/widgets",
                  "**/app",
                  "**/entities",
                  "**/shared",
                  "**/application/**",
                  "!**/application/ports/networkTransport",
                  "**/application"
                ],
                "message": "Adapters may import the domain, packages other than React/Zustand, and each other only (ADR-009)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/entities/**",
        "src/features/**",
        "src/pages/**",
        "src/widgets/**",
        "src/shared/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/adapters/**"],
                "message": "Only app/ composes adapters (ADR-009)."
              },
              {
                "group": [
                  "**/application/stores/**",
                  "**/application/ports/**",
                  "**/application/useCases/**",
                  "**/application/stores",
                  "**/application/ports",
                  "**/application/useCases"
                ],
                "message": "Import from the application barrel (src/application), not past it (ADR-009)."
              },
              {
                "group": ["**/application/testing"],
                "message": "application/testing seeds state in tests only (ADR-009)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/app/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/application/stores/**",
                  "**/application/ports/**",
                  "**/application/useCases/**",
                  "**/application/stores",
                  "**/application/ports",
                  "**/application/useCases"
                ],
                "message": "Import from the application barrel (src/application), not past it (ADR-009)."
              },
              {
                "group": ["**/application/testing"],
                "message": "application/testing seeds state in tests only (ADR-009)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/application/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/features",
                  "**/features/**",
                  "**/pages",
                  "**/pages/**",
                  "**/widgets",
                  "**/widgets/**",
                  "**/app",
                  "**/app/**",
                  "**/entities",
                  "**/entities/**",
                  "**/shared",
                  "**/shared/**",
                  "react-router",
                  "react-router/**",
                  "react-router-dom",
                  "react-router-dom/**",
                  "trystero",
                  "trystero/**",
                  "@trystero-p2p/**"
                ],
                "message": "The application layer imports only the domain and itself; UI layers are above it (ADR-009)."
              },
              {
                "group": ["**/adapters/**", "**/adapters"],
                "message": "The application layer owns ports; only app/ wires adapters (ADR-009)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/entities/**/*.test.ts",
        "src/features/**/*.test.ts",
        "src/pages/**/*.test.ts",
        "src/widgets/**/*.test.ts",
        "src/shared/**/*.test.ts",
        "src/entities/**/*.test.tsx",
        "src/features/**/*.test.tsx",
        "src/pages/**/*.test.tsx",
        "src/widgets/**/*.test.tsx",
        "src/shared/**/*.test.tsx"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/adapters/**"],
                "message": "Only app/ composes adapters (ADR-009)."
              },
              {
                "group": [
                  "**/application/stores/**",
                  "**/application/ports/**",
                  "**/application/useCases/**",
                  "**/application/stores",
                  "**/application/ports",
                  "**/application/useCases"
                ],
                "message": "Import from the application barrel (src/application), not past it (ADR-009)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/app/**/*.test.ts", "src/app/**/*.test.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/application/stores/**",
                  "**/application/ports/**",
                  "**/application/useCases/**",
                  "**/application/stores",
                  "**/application/ports",
                  "**/application/useCases"
                ],
                "message": "Import from the application barrel (src/application), not past it (ADR-009)."
              }
            ]
          }
        ]
      }
    }
  ]
}
