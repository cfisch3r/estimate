{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": [
        "src/**/*.{ts,tsx}",
        "e2e/**/*.ts",
        "specs/**/*.ts",
        "scripts/**/*.test.ts",
        ".claude/skills/*/scripts/**/*.test.ts"
      ],
      "entry": [
        "steiger.config.ts",
        "e2e/relay-server.mjs",
        "specs/**/{steps,world}.ts",
        "specs/shared/integration/harness/harness.ts"
      ],
      "ignoreDependencies": ["fta-cli"]
    },
    "site": {
      "entry": ["lib/**/*.test.ts"],
      "project": ["lib/**/*.ts", "scripts/**/*.ts", ".vitepress/**/*.{mts,ts,vue}"]
    }
  }
}
